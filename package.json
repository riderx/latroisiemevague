{
  "name": "latroisiemevague",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "crawl": "node scripts/crawl-wordpress.mjs && node scripts/complete-import.mjs",
    "build": "astro build",
    "check": "astro check && tsc -p tsconfig.worker.json",
    "preview": "wrangler dev",
    "deploy": "bun run db:migrate && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "test": "node --experimental-strip-types --test tests/forms.test.ts",
    "test:browser": "playwright test",
    "verify:migration": "node scripts/verify-migration.mjs",
    "types": "wrangler types worker-configuration.d.ts"
  },
  "dependencies": {
    "astro": "6.3.1",
    "cheerio": "^1.1.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.101.0"
  }
}
