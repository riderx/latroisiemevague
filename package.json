{
  "name": "latroisiemevague",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/build-markdown.mjs",
    "check": "astro check && tsc -p tsconfig.worker.json",
    "preview": "wrangler dev",
    "deploy": "bun run db:migrate && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "verify:site": "node scripts/verify-site.mjs && node scripts/verify-guides.mjs && node scripts/verify-article-seo.mjs",
    "import:guides": "node scripts/import-thirdwave.mjs && node scripts/review-thirdwave.mjs && node scripts/translate-thirdwave.mjs && node scripts/apply-guide-corrections.mjs",
    "types": "wrangler types worker-configuration.d.ts"
  },
  "dependencies": {
    "astro": "6.3.1",
    "cheerio": "^1.1.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.0.0",
    "@types/opentype.js": "^1.3.10",
    "@types/turndown": "^5.0.6",
    "opentype.js": "^2.0.0",
    "turndown": "7.2.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.101.0"
  }
}
