---
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Logo from './Logo.astro'
import Arrow from './Arrow.astro'
import { families, substanceBySlug, shortName, illustrationFor, nav } from '../data/site'
import { articles } from '../lib/articles'
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/ill/*.webp', { eager: true })
const thumb = async (name: string) => (await getImage({ src: files[`../assets/ill/${name}.webp`].default, width: 360, format: 'webp', quality: 75 })).src
const current = Astro.url.pathname
const famLinks = await Promise.all(families.map(async f => ({ ...f, links: await Promise.all(f.slugs.map(async slug => {
  const g = substanceBySlug(slug); return { name: shortName(slug, g.name), href: g.path, img: await thumb(illustrationFor(slug)) }
})) })))
const latest = await Promise.all(articles.slice(0, 6).map(async a => ({ title: a.title, href: a.path, category: a.category, img: await thumb(a.cover) })))
const featSubst = await thumb('s-psilocybine'), featArt = await thumb('library')
const chev = '<svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" fill="none" stroke-width="1.3"/></svg>'
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href))
---
<a class="skip" href="#contenu">Aller au contenu</a>
<header class="site-header"><div class="bar">
  <a class="logo" href="/" aria-label="La Troisième Vague, accueil"><Logo /><span>La Troisième <i>Vague</i></span></a>
  <nav class="main" aria-label="Navigation principale">
    {nav.map(item => item.mega === 'substances' ? (
      <div class="dd"><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label} <Fragment set:html={chev} /></a>
        <div class="mega"><div class="mgrid">{famLinks.map(f => (
          <div class="mcol" style={f.slugs.length > 8 ? '--span:2' : undefined}><h6>{f.name}</h6><div class="mlinks">{f.links.map(l => <a href={l.href} data-img={l.img} data-t={l.name}><span>{l.name}</span></a>)}</div></div>
        ))}</div>
        <a href="/substances/" class="feat k2"><span class="fimg"><img src={featSubst} alt="" width="180" height="180" loading="lazy" /></span><span class="ftxt"><b>Les 22 fiches</b><span>Effets, risques, interactions et statut légal de chaque substance.</span></span><span class="fcta">Toutes les fiches<i><Arrow /></i></span></a></div></div>
    ) : item.mega === 'articles' ? (
      <div class="dd"><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label} <Fragment set:html={chev} /></a>
        <div class="mega narrow"><div class="lessons">{latest.map((a, i) => <a href={a.href} class="lesson" data-img={a.img} data-t={a.title}><em>{String(i + 1).padStart(2, '0')}</em><span><b>{a.title}</b><span>{a.category}</span></span></a>)}</div>
        <a href="/blog/" class="feat k4"><span class="fimg"><img src={featArt} alt="" width="180" height="180" loading="lazy" /></span><span class="ftxt"><b>Tous les articles</b><span>Recherche, histoire et réduction des risques.</span></span><span class="fcta">Lire les articles<i><Arrow /></i></span></a></div></div>
    ) : <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <div class="end"><a class="btn l" href="/aide/"><span class="hm">Besoin d’aide</span><span class="sm">Aide</span><Arrow /></a></div>
  <button class="burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mnav"><span></span></button>
</div>
</header>
<nav class="mnav" id="mnav" aria-label="Menu mobile">
  <details><summary>Substances</summary><div>{famLinks.flatMap(f => f.links).map(l => <a href={l.href}>{l.name}</a>)}</div></details>
  <a href="/microdosing/">Microdosage</a><a href="/blog/">Articles</a><a href="/aide/">Aide et urgences</a><a href="/a-propos/">À propos</a><a href="/contact/">Contact</a><a href="/recherche/">Rechercher</a>
</nav>
<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger')!
  burger.addEventListener('click', () => {
    const open = document.body.classList.toggle('menu-open')
    burger.setAttribute('aria-expanded', String(open)); burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu')
  })
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && document.body.classList.contains('menu-open')) burger.click() })
  document.querySelectorAll<HTMLElement>('.mega').forEach(m => {
    const img = m.querySelector<HTMLImageElement>('.fimg img'), t = m.querySelector('.ftxt b')
    if (!img || !t) return
    const d0 = img.src, t0 = t.textContent
    m.querySelectorAll<HTMLElement>('[data-img]').forEach(a => a.addEventListener('pointerenter', () => { img.src = a.dataset.img!; t.textContent = a.dataset.t! }))
    m.addEventListener('pointerleave', () => { img.src = d0; t.textContent = t0 })
  })
</script>
