---
/** Illustration from src/assets/ill, served as responsive WebP/AVIF. */
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/ill/*.webp', { eager: true })
interface Props { name: string; alt?: string; widths?: number[]; sizes?: string; class?: string; style?: string; loading?: 'lazy' | 'eager'; fetchpriority?: 'high' | 'low' | 'auto' }
const { name, alt = '', widths = [240, 400, 640], sizes = '(max-width: 960px) 60vw, 320px', class: cls, style, loading = 'lazy', fetchpriority } = Astro.props
const file = files[`../assets/ill/${name}.webp`]
if (!file) throw new Error(`Missing illustration: ${name}`)
const max = file.default.width
const w = widths.filter(x => x <= max)
---
<Picture src={file.default} alt={alt} widths={w.length ? w : [max]} sizes={sizes} formats={['avif', 'webp']} fallbackFormat="webp" quality={58} class={cls} style={style} loading={loading} decoding="async" fetchpriority={fetchpriority} />
