---
import '../styles/listing.css'
import Base from './Base.astro'
import Ill from '../components/Ill.astro'
import Arrow from '../components/Arrow.astro'

import { listingPages, listingSections, listingGuides, protocols, type ListingCategory } from '../content-data/listings'
import { families, illustrationFor, tintFor, shortName, SITE } from '../data/site'
const { category } = Astro.props as { category: ListingCategory }
const path = category === 'psychedelics' ? '/substances/' : '/microdosing/'
const page = listingPages[path]
const guides = listingGuides(category).filter(g => g.available)
const groups = category === 'psychedelics'
  ? families.map(f => ({ id: f.id, title: f.name, items: f.slugs.map(s => guides.find(g => g.slug === s)!).filter(Boolean) }))
  : [{ id: 'guides', title: 'Les guides du microdosage', items: guides }]
const famIntro: Record<string, string> = {
  classiques: 'Les molécules qui agissent principalement sur le récepteur sérotoninergique 5-HT2A, et les plantes qui les contiennent.',
  dissociatifs: 'Des mécanismes différents des psychédéliques classiques, et des profils de risque très distincts.',
  empathogenes: 'Des substances qui agissent surtout sur la libération de sérotonine.',
  plantes: 'Des plantes et des préparations issues de traditions, aux effets et aux risques très variés.',
  guides: 'Ce que l’on sait du microdosage, substance par substance, avec les limites des études.',
}
const schema = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: page.heading, description: page.description, url: SITE + path, inLanguage: 'fr-FR',
  mainEntity: { '@type': 'ItemList', itemListElement: guides.map((g, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + g.path, name: g.name })) } }
---
<Base title={page.title} description={page.description} path={path} schema={schema}>
  <section class="lhead"><div class="in">
    <div>
      <nav class="crumbs" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span aria-hidden="true">›</span><span>{category === 'psychedelics' ? 'Substances' : 'Microdosage'}</span></nav>
      <h1>{category === 'psychedelics' ? <>Les substances, <em>une par une</em></> : <>Le microdosage, <em>sans raccourcis</em></>}</h1>
      <p class="lede">{page.introduction}</p>
      {groups.length > 1 && <p class="jump">{groups.map(g => <a href={`#${g.id}`}>{g.title}</a>)}</p>}
    </div>
    <div class="art"><Ill name={category === 'psychedelics' ? 'specimen-base' : 'molecule-base'} widths={[320, 480]} sizes="(max-width: 960px) 240px, 420px" loading="eager" fetchpriority="high" /></div>
  </div></section>
  {groups.map(g => (
    <section class="fam" id={g.id}><div class="in">
      <div class="fam-h"><h2>{g.title}</h2><p>{famIntro[g.id]}</p><span class="count">{g.items.length} {g.items.length > 1 ? 'fiches' : 'fiche'}</span></div>
      <div class="sgrid">{g.items.map(item => (
        <a class="sc listing-card" href={item.path}><span class={`disc2 ${tintFor(item.slug)}`}><Ill name={illustrationFor(item.slug)} widths={[200, 320, 400]} sizes="(max-width: 960px) 45vw, 240px" /></span><h3><span>{shortName(item.slug, item.name)}</span></h3><p>{item.description}</p></a>
      ))}</div>
    </div></section>
  ))}
  {category === 'microdosing' && (
    <section class="psec"><div class="in">
      <div class="psec-h"><h2>Protocoles : <em>de quoi parle-t-on&#8239;?</em></h2><p>Trois approches souvent citées dans les discussions sur le microdosage, et ce qu’elles ne prouvent pas.</p></div>
      <ol class="protos">{protocols.map((p, i) => <li class={`proto k${(i % 4) + 1}`}><span class="pnum">{String(i + 1).padStart(2, '0')}</span><small>{p.label}</small><h3>{p.name}</h3><p>{p.text}</p><p class="warn"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M10 2.5 18 17H2z" stroke-linejoin="round"/><path d="M10 8v4M10 14.5v.3"/></svg><span>{p.note}</span></p></li>)}</ol>
    </div></section>
  )}
  <section class="explain pat"><div class="in grid">
    <h2>Les repères <em>essentiels</em></h2>
    <div class="acc">{listingSections[category].map((s, i) => (
      <div class={`acc-i${i === 0 ? ' open' : ''}`} id={s.id}><button type="button" aria-expanded={i === 0 ? 'true' : 'false'}>{s.title}<span class="pm"></span></button><div class="acc-p"><div><div class="prose-sm" set:html={s.html} /></div></div></div>
    ))}</div>
  </div></section>
  <section class="sec center"><div class="in">
    <h2 class="h2">Avant tout, <em>la sécurité</em></h2>
    <p class="lede">Interactions médicamenteuses, contre-indications, que faire si une expérience tourne mal : les repères à connaître, et les numéros à appeler.</p>
    <p style="margin-top:26px"><a class="btn p" href="/aide/">Aide et repères de sécurité<Arrow /></a></p>
  </div></section>
</Base>
