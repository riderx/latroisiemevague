---
import '../styles/pages.css'
import Base from '../layouts/Base.astro'
---
<Base title="Rechercher | La Troisième Vague" description="Rechercher dans les fiches et les articles de La Troisième Vague." noindex>
  <section class="pagehead"><div class="in">
    <h1>Rechercher</h1>
    <form class="search" role="search" action="/recherche/"><label class="sr" for="q">Rechercher sur La Troisième Vague</label><input type="search" id="q" name="s" required placeholder="Une substance, un sujet…" /><button class="btn p" type="submit">Rechercher</button></form>
    <p id="search-status" role="status" style="margin-top:18px;color:var(--ink-3)"></p>
    <div class="results" id="results"></div>
  </div></section>
</Base>
<script>
  const query = new URLSearchParams(location.search).get('s') || ''
  const input = document.querySelector<HTMLInputElement>('#q')!, status = document.querySelector('#search-status')!, results = document.querySelector('#results')!
  input.value = query
  if (query) {
    try {
      const pages: { title: string; path: string; description: string; text: string }[] = await (await fetch('/search.json')).json()
      const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase()
      const words = norm(query).split(/\s+/).filter(Boolean)
      const scored = pages.map(p => { const t = norm(p.title), b = norm(p.text); return { p, ok: words.every(w => t.includes(w) || b.includes(w)), s: words.reduce((n, w) => n + (t.includes(w) ? 5 : 0) + (b.split(w).length - 1), 0) } }).filter(x => x.ok).sort((a, b) => b.s - a.s)
      status.textContent = `${scored.length} résultat${scored.length === 1 ? '' : 's'}`
      for (const { p } of scored) {
        const a = document.createElement('a'), b = document.createElement('b'), d = document.createElement('span')
        a.href = p.path; b.textContent = p.title.replace(/ \| La Troisième Vague$/, ''); d.textContent = p.description || p.text.slice(0, 200)
        a.append(b, d); results.append(a)
      }
    } catch { status.textContent = 'La recherche est indisponible. Veuillez réessayer.' }
  }
</script>
