{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "latroisiemevague-v2",
  "main": "worker/forms.ts",
  "compatibility_date": "2026-06-23",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "latroisiemevague",
      "database_id": "03887bb8-94b3-40ef-8a6a-35a45b634ab3",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "contact@latroisiemevague.com"
      ],
      "allowed_destination_addresses": [
        "martindonadieu@gmail.com",
        "orion.aubert@gmail.com"
      ]
    }
  ],
  "vars": {
    "EMAIL_FROM": "contact@latroisiemevague.com"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/_astro/*", "!/fonts/*", "!/assets/*", "!/og/*"]
  },
  "routes": [
    {
      "pattern": "latroisiemevague.com/*",
      "zone_name": "latroisiemevague.com"
    },
    {
      "pattern": "www.latroisiemevague.com/*",
      "zone_name": "latroisiemevague.com"
    }
  ]
}
